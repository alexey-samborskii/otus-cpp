@startuml
title Request flow: browser request processing

skinparam shadowing false
skinparam activity {
    BackgroundColor #F8FAFC
    BorderColor #334155
    ArrowColor #334155
}

start
:Browser sends HTTP/HTTPS request;
:WebServer accepts TCP connection;

if (HTTPS?) then (yes)
    :HttpsSession performs TLS handshake;
else (no)
    :HttpSession starts plain TCP session;
endif

:HttpSessionBase::processRequests();
:Session reads request with Beast parser;
:Apply request body limit;
:Create server::HttpRequest;
:makeHandlerWithException records request metric;
:Strip query string for top-level routing;

if (target == /metrics?) then (metrics)
    if (method == GET?) then (yes)
        :Collect ApplicationMetrics;
        :Collect TaskScheduler metrics;
        :Build Prometheus text response;
    else (no)
        :Build 405 Method Not Allowed response;
    endif
elseif (target starts with /api/?) then (API request)
    :TaskApiHandler parses route;

    if (GET /api/tasks?) then (yes)
        :TaskService.findAll();
        :TaskRepository reads tasks from SQLite;
        :Build JSON list response;
    elseif (POST /api/tasks?) then (yes)
        :Parse JSON body to TaskInput;
        :TaskService.create(input);
        :TaskRepository inserts task into SQLite;
        :TaskScheduler schedules timer;
        :Build JSON created response;
    elseif (GET /api/tasks/{id}?) then (yes)
        :TaskService.findById(id);
        :TaskRepository reads task from SQLite;
        :Build JSON item response;
    elseif (PUT /api/tasks/{id}?) then (yes)
        :Parse JSON body to TaskInput;
        :TaskService.update(id, input);
        :TaskRepository updates task in SQLite;
        :TaskScheduler reschedules timer;
        :Build JSON updated response;
    elseif (DELETE /api/tasks/{id}?) then (yes)
        :TaskService.remove(id);
        :TaskRepository deletes task from SQLite;
        :TaskScheduler cancels timer;
        :Build 204 No Content response;
    elseif (POST /api/tasks/{id}/run?) then (yes)
        :TaskService.runNow(id);
        :TaskScheduler starts task immediately;
        :Build JSON item response;
    else (unknown API route or method)
        :Build 404 or 405 response;
    endif
else (static file request)
    :StaticFileHandler removes query string;
    :StaticFileHandler resolves path in public/;
    if (file exists and target is valid?) then (yes)
        :Read index.html / styles.css / app.js;
        :Build file response with content type;
    else (no)
        :Build 404 response;
    endif
endif

if (handler exception?) then (yes)
    :Record exception metric;
    :Build 500 Internal Server Error response;
else (no)
    :Record response status metric;
endif

:Convert server::HttpResponse to Beast response;
:Session writes response to socket;
:Browser receives response;
stop

legend right
Scheduler timer flow:
TaskScheduler timer fires ->
TaskRepository.claimForExecution() ->
status = running ->
execute task ->
status = completed/failed
endlegend
@enduml
